{
  "name": "@primitive.ai/prim",
  "version": "0.1.0-alpha.66",
  "description": "CLI for Primitive's decision graph — passive decision capture, conflict gate, and team presence",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campus-ai/prim.git"
  },
  "homepage": "https://github.com/campus-ai/prim#readme",
  "bugs": {
    "url": "https://github.com/campus-ai/prim/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "primitive",
    "prim",
    "cli",
    "decisions",
    "decision-graph",
    "pre-commit"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "bin": {
    "prim": "dist/index.js",
    "prim-pre-commit": "dist/hooks/pre-commit.js",
    "prim-post-commit": "dist/hooks/post-commit.js",
    "prim-post-rewrite": "dist/hooks/post-rewrite.js",
    "prim-hook": "dist/hooks/prim-hook.js",
    "prim-pre-tool-use": "dist/hooks/pre-tool-use.js",
    "prim-post-tool-use": "dist/hooks/post-tool-use.js",
    "prim-session-start": "dist/hooks/session-start.js",
    "prim-session-end": "dist/hooks/session-end.js",
    "prim-daemon-server": "dist/daemon/server.js",
    "prim-statusline": "dist/statusline-main.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/hooks/pre-commit.ts src/hooks/post-commit.ts src/hooks/post-rewrite.ts src/hooks/prim-hook.ts src/hooks/pre-tool-use.ts src/hooks/post-tool-use.ts src/hooks/session-start.ts src/hooks/session-end.ts --format esm --clean && tsup src/statusline-main.ts src/daemon/server.ts --format esm --splitting false",
    "postbuild": "chmod +x ./dist/index.js ./dist/statusline-main.js ./dist/hooks/pre-commit.js ./dist/hooks/post-commit.js ./dist/hooks/post-rewrite.js ./dist/hooks/prim-hook.js ./dist/hooks/pre-tool-use.js ./dist/hooks/post-tool-use.js ./dist/hooks/session-start.js ./dist/hooks/session-end.js ./dist/daemon/server.js",
    "dev": "tsup src/index.ts src/statusline-main.ts src/hooks/pre-commit.ts src/hooks/post-commit.ts src/hooks/post-rewrite.ts src/hooks/prim-hook.ts src/hooks/pre-tool-use.ts src/hooks/post-tool-use.ts src/hooks/session-start.ts src/hooks/session-end.ts src/daemon/server.ts --format esm --watch --clean --splitting false",
    "clean": "rm -rf dist coverage",
    "lint": "biome check src/",
    "format": "biome check --fix src/",
    "format:check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "unbash": "4.0.3",
    "update-notifier": "^7.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/diff": "^5.2.0",
    "@types/node": "^25.5.0",
    "@types/update-notifier": "^6.0.8",
    "@vitest/coverage-v8": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  }
}
